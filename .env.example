# U.S. Census Bureau API Key (optional but recommended for high-volume automated queries)
# You can request a free API key at: https://api.census.gov/data/key_signup.html
# If left blank, the pipeline will utilize direct authenticated/official bulk downloads from Census servers.
CENSUS_API_KEY=

# OpenStreetMap Overpass custom endpoint (optional)
# Defaults to https://overpass-api.de/api if not specified
OVERPASS_ENDPOINT=https://overpass-api.de/api

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
